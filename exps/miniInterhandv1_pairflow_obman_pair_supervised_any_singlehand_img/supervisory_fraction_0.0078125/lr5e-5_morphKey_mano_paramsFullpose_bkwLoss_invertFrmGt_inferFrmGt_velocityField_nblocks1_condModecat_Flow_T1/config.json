{
  "inherit_from":"configs/miniInterhandv1/pairflow_obman.json",
  "training":{
    "vis_freq":10000,
    "eval_freq":10,
    "backup_freq":500,
    "fix_base_batch_norm":true, 
    #"grad_norm_clip": false,
    #"grad_norm_clip_value": 0.0,
    "optimizer":"Adam",
    "optimizer_kwargs":{"weight_decay":0.0},
    "lr": 5e-5,
    #"scheduler":"ExponentialLR",
    #"scheduler_kwargs":{"gamma":0.99, "last_epoch":-1},
    "num_epochs": 1000,
    "dataloader":{
      "batch_size":32,
      "workers": 8,
      "datasets":{
        "pair_supervised_any_singlehand_img":{
          "split":"train",         
          "supervise_fraction": 0.0078125,
          "add_first_last_frame": true,
          "gap":[1,32], 
          "do_augment":true,
          "labelset": [
            "image",
            "joints3d",
            "joints3d_rel",
            "mano_params",
            "verts3d"]
        }
      }
    }
  },
  "evaluating":{
    "dataloader":{
      "batch_size":8,
      "workers": 2,
      "datasets":{
        "pair_supervised_unsupervised_singlehand_img":{#loading all Supervised images
          "split":"train",          
          "supervise_fraction": 0.0078125,
          "add_first_last_frame": true,
          "gap":[1,32],
          "do_augment":false,
          "labelset": [
            "image",
            "joints3d",
            "joints3d_rel",
            "mano_params",
            "verts3d"]
        }
      }
    }
  },
  "testing":{
    #"dataloader":{
    #  "batch_size":32,
    #  "workers": 8,
    #  "datasets":{
    #    "pair_unsupervised_supervised_singlehand_img":{#loading all Unsupervised images
    #      "split":"train",          
    #      "supervise_fraction": 0.0078125,
    #      "add_first_last_frame": true,
    #      "do_augment":false,
    #      "labelset": [
    #        "image",
    #        "joints3d",
    #        "joints3d_rel",
    #        "mano_params",
    #        "verts3d"]
    #    }
    #  }
    #}
  },
  "model":{
    "name":"pairflow",
    "pairflow":{
      "morph_key":"mano_params",
      "morph_shape":false,
      "invert_from_gts":true,
      "infer_from_gts":true,
      "velocity_field_kwargs":{
        "in_dim":51,
        "out_dim":51,
        "n_blocks":1,
        "cond_mode":"cat",
        "use_positional_encoding":false
      },
      "flow":"resflow",
      "flow_kwargs":{"T":1},
      "mesh_predictor":"obman",
      "mesh_predictor_kwargs":{
        "pretrained_file":"exps-01/miniInterhandv1_obman_supervised_singlehand_img/supervisory_fraction_0.0078125/lr5e-5/run/ckpt_epoch800.pt",
        "freeze":{
          "whole":true
        }
      },
      "loss":{
        "loss_types":["flow_s", "flow_u"],
        "flow_s":{
          "ordinary":{
            "joints3d":[0.5,"l2"],
            #"verts3d":[0.5,"l2"],
            "mano_shapes":[5e-7,"penalty"],
            "mano_poses":[5e-6,"penalty"]
            }
        },
        "flow_u":{
          #"tfeq":{
            #"joints3d":[0.5,"l2"],
            #"verts3d":[0.5,"l2"],
            #"mano_shapes":[5e-7,"penalty"],
            #"mano_poses":[5e-6,"penalty"]
            #},
           "bkw":{
            "joints3d":[0.5,"l2"],
            #"verts3d":[0.5,"l2"],
            "mano_shapes":[5e-7,"penalty"],
            "mano_poses":[5e-6,"penalty"]
            }
        }
      }
    }
  }
}
