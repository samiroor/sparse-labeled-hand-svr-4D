{
  "inherit_from":"configs/miniInterhandv1/obman.json",
  "training":{
    "vis_freq":250,
    "eval_freq":25,
    "backup_freq":400,
    "fix_base_batch_norm":true, 
    #"grad_norm_clip": false,
    #"grad_norm_clip_value": 0.0,
    "optimizer":"Adam",
    "optimizer_kwargs":{"weight_decay":0.0},
    "lr": 5e-5,
    #"scheduler":"ExponentialLR",
    #"scheduler_kwargs":{"gamma":0.99, "last_epoch":-1},
    "num_epochs": 1000,
    "dataloader":{
      "batch_sampler":"supervised_unsupervised",
      "batch_sampler_kwargs":{
        "supervised_batch_size":32,
        "unsupervised_batch_size":32
      },
      "workers": 8,
      "datasets":{
        "supervised_singlehand_img":{
          "split":"train",
          "supervise_fraction": 0.0078125,
          "add_first_last_frame": true,
          "do_augment":true,
          "labelset": [
            "image",
            "joints3d",
            "joints3d_rel",
            "mano_params",
            "verts3d"]
        },
        "unsupervised_singlehand_img":{
          "split":"train",
          "supervise_fraction": 0.0078125,
          "add_first_last_frame": true,
          "do_augment":true,
          "labelset": [
            "image",
            "joints3d",
            "joints3d_rel",
            "mano_params",
            "verts3d"]
        }
      }
    }
  },
  "evaluating":{
    "dataloader":{
      "batch_size":32,
      "workers": 8,
      "datasets":{
        "singlehand_img":{
          "split":"val", 
          "supervise_fraction": 1.0,
          "add_first_last_frame": true,
          "do_augment":false,
          "labelset": [
            "image",
            "joints3d",
            "joints3d_rel",
            "mano_params",
            "verts3d"]
        }
      }
    }
  },
  "testing":{
#    "dataloader":{
#      "batch_size":64,
#      "workers": 8,
#      "datasets":{
#        "unsupervised_singlehand_img":{
#          "split":"train",
#          "supervise_fraction": 0.015625,
#          "add_first_last_frame": true,
#          "do_augment":false,
#          "labelset": [
#            "image",
#            "joints3d",
#            "joints3d_rel",
#            "mano_params",
#            "verts3d"]
#        }
#      }
#    }
  },
  "data_spec":{},
  "augmentation":{},
  "metrics":{},
  "model":{
    "name":"obman",
    "obman":{
      #"pretrained_file":"",
      "loss":{
        "loss_types":["mesh_predictor_s", "mesh_predictor_u"],
        "mesh_predictor_s":{
          "ordinary":{
            "joints3d":[0.5,"l2"],
            #"verts3d":[0.5,"l2"],
            "mano_shapes":[5e-7,"penalty"],
            "mano_poses":[5e-6,"penalty"]
          }
        },
        "mesh_predictor_u":{
          "tfeq":{
            "joints3d":[0.005,"l2"],
            #"verts3d":[0.005,"l2"],
            "mano_shapes":[5e-9,"penalty"],
            "mano_poses":[5e-8,"penalty"]
          }
        }
      }
    }
  }
}
