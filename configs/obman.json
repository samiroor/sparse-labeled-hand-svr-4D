{ 
  "inherit_from":null, # when you run add a data json path
  "vis_freq":10,
  "eval_freq":1,
  "training":{
    "fix_base_batch_norm":true, 
    #"grad_norm_clip": false,
    #"grad_norm_clip_value": 0.0,
    "optimizer":"Adam",
    "optimizer_kwargs":{"weight_decay":0.0},
    "lr": 1e-4,
    "scheduler":"ExponentialLR",
    "scheduler_kwargs":{"gamma":0.95, "last_epoch":-1},
    "num_epochs": 100,
    "dataloader":{
      "batch_size":32,
      "workers": 8,
      "datasets":{} #should come from parent config
    }
  },
  "evaluating":{
    "dataloader":{
      "batch_size":32,
      "workers": 8,
      "datasets":{}
    }
  },
  "metrics":{
    "names":["hand3d"],
    "ops":{"xyz_mean3d":"min"}#{"loss": "min"}
  },
  "model":{
    "name":"obman",
    "obman":{
      "c_dim":512,
      "h_dim":512,
      "scale_factor":0.0001,
      "trans_factor":100,
      "return_mano_features":false,
      "return_encoder_features":false,
      "use_adaptor":false, # when data is fphab it should be true,
      "adaptor_path":null,
      "ncomps":15,
      "use_pca":true,
      "use_shape":true,
      "ref_side":"right",
      "center_idx":0,
      "annot_metric":"m",
      "encoder":"resnet18",
      "mano_base":"fcs",
      "st_head":"fcs",
      "obj_st_head":null,
      "loss":{
        "joints3d":[0.5,"l2"],
        "objverts3d":[0.5,"l2"],
        "mano_shapes":[5e-7,"penalty"],
        "mano_poses":[5e-6,"penalty"]
      }
    }
  }
}
