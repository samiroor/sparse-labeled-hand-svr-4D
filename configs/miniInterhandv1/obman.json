{ 
  "inherit_from":"configs/miniInterhandv1/data_cfg.json",
  "metrics":{
    "names":["hand3d"],
    "ops":{
      #"mesh_predictor_s__xyz_mean3d":"min",
      #"mesh_predictor_u__xyz_mean3d":"min",
      "loss":"min"
    }
  },
  "model":{
    "name":"obman",
    "obman":{
      "c_dim":512,
      "h_dim":512,
      "scale_factor":0.0001,
      "trans_factor":100,
      "off_z":1.0,
      "return_tail_features":false,
      "return_encoder_tail_features":false,
      "return_encoder_features":false,
      "return_encoder_spatial_features":false,
      "adaptor_path":null,
      "ncomps":15,
      "use_pca":true,
      "use_shape":true,
      "ref_side":"right",
      "center_idx":0,
      "annot_metric":"m",
      "encoder":"resnet18",
      "encoder_kwargs":{
        "c_dim":512, #reduced feat out_dim
        "use_linear":true, #put an extra fc
        "return_spatial_features":false,
        "return_layer":"layer4"
      },
      "mano_base":"fcs",
      "mano_base_kwargs":{
        "ch_in":512, #c_dim,
        "ch_out":512, #h_dim,
        "ch_hiddens":[512],
        "activation":"relu",
        "dropout":0.0,
        "flatten":false
      },
      "st_head":"fcs",
      "obj_st_head":null,
      "loss":{
