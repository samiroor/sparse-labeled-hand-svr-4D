          #"ordinary":{
            #"joints3d":[0.5,"l2"],
            #"verts3d":[0.5,"l2"],
            #"mano_shapes":[5e-7,"penalty"],
            #"mano_poses":[5e-6,"penalty"]
            #}
        #},
        #"mesh_predictor_u":{
          #"tfeq":{
            #"joints3d":[0.5,"l2"],
            #"verts3d":[0.5,"l2"],
            #"mano_shapes":[5e-7,"penalty"],
            #"mano_poses":[5e-6,"penalty"]
            #}
        #}
      }
    }
  }
}
