  "model":{
    "name":"pairflow",
    "pairflow":{
      "pretrained_file":null,
      #"morph_key":"verts3d",
      "morph_key":"mano_params",
      "morph_shape":false,
      "use_gt_mano_shape":true,
      "invert_from_gts":true,
      "infer_from_gts":true,
      "use_tail_features":false,
      "use_encoder_tail_features":false,
      "use_encoder_spatial_features":false,
      "context":{
        "context_base":"fcs",
        "context_base_kwargs":{
          "ch_in":512, #"mesh predictor out feature_dim",
          "ch_hiddens":[512],
          "ch_out":512,
          "activation":"relu",
          "dropout":0.0,
          "flatten":false
        },
        "context_head":null,
       # "context_head_kwargs":{
       #   "ch_in":512, #"context_base out feature_dim",
       #   "ch_hiddens":[512],
       #   "ch_out":512,
       #   "activation":"relu",
       #   "dropout":0.0,
       #   "flatten":false
       # }
      },
      "velocity_field":"rotation_translation",
      "velocity_field_kwargs":{
        "in_dim":51,
        "angular_dim":48,
        "c_dim":512,
        "hidden_size":512,
        "n_blocks":1,
        "cond_mode":"cat",
        "activation":"tanh",
        "rot_mode":"axisang",
        "disentangle":false,
        "temperature_scaling":true
      },
      "flow":"rotation_translation",
      "flow_kwargs":{
        "T":1,
        "return_multiTime":false
      },
      "mesh_predictor":"obman",
      "mesh_predictor_kwargs":{
        "pretrained_file":null,
        "freeze":{
          "whole":false
        },
        "c_dim":512,
        "h_dim":512,
        "scale_factor":0.0001,
        "trans_factor":100,
        "off_z":1.0,
        "return_tail_features":false,
        "return_encoder_tail_features":false,
        "return_encoder_features":true,
        "return_encoder_spatial_features":false,
        "adaptor_path":null,
        "ncomps":15,
        "use_pca":true,
        "use_shape":true,
        "ref_side":"right",
        "center_idx":0,
        "annot_metric":"m",
        "encoder":"resnet18",
        "encoder_kwargs":{
          "c_dim":512, #reduced feat out_dim
          "use_linear":false, #put an extra fc
          "return_spatial_features":false,
          "return_layer":"layer4"
        },
        "mano_base":"fcs",
        "mano_base_kwargs":{
          "ch_in":512, #c_dim,
          "ch_out":512, #h_dim,
          "ch_hiddens":[512],
          "activation":"relu",
          "dropout":0.0,
          "flatten":false
        },
        "st_head":"fcs",
        "obj_st_head":null,
        "attention_head":null
      },
      "loss":{
        #"loss_types":["mesh_predictor_s", "mesh_predictor_u", "flow_s", "flow_u"],
