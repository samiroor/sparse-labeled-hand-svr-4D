{ 
  "inherit_from":"configs/miniInterhandv1/data_cfg.json",
  "metrics":{
    "names":["hand3d"],
    "ops":{
      #"mesh_predictor_s__xyz_mean3d":"min",
      #"mesh_predictor_u__xyz_mean3d":"min",
      #"flow_s__xyz_mean3d":"min",
      #"flow_u__xyz_mean3d":"min",
      "loss":"min"
    }
  },
  "model":{
    "name":"pairflow",
    "pairflow":{
      "morph_key":"verts3d",
      "use_tail_features":false,
      "context_base":"fcs",
      "context_base_kwargs":{
        "ch_in":512, #"feature_dim",
        "ch_hiddens":[512],
        "ch_out":512,
        "activation":"relu",
        "dropout":0.0,
        "flatten":false
      },
      "context_head":"subtract",
      "context_head_kwargs":{},
      "velocity_field":"resblock",
      "velocity_field_kwargs":{
        "c_dim":512, #"feature_dim", #out of context head
        "hidden_size":512,
        "activation":"tanh",
        "n_blocks":3,
        "cond_mode":"add",
        "use_positional_encoding":false,
        "positional_encoding_kwargs":{
          "linear":true,
          "length":16
        }
      },
      "flow":"resflow",
      "flow_kwargs":{
        "T":3,
        "displacement":0.3,
        "return_multiTime":false,
        "return_weighted_avg":false,
        "gamma":0.4
      },
      "mesh_predictor":"obman",
      "mesh_predictor_kwargs":{
        "pretrained_file":null,
        "freeze":{},
        "c_dim":512,
        "h_dim":512,
        "scale_factor":0.0001, 
        "trans_factor":100,    
        "off_z":1.0,          
        "return_tail_features":false,
        "return_encoder_features":true,
        "return_encoder_spatial_features":false,
        "ncomps":15,
        "use_pca":true,
        "use_shape":true,
        "ref_side":"right",
        "center_idx":0,
        "annot_metric":"m",
        "encoder":"resnet18",
        "mano_base":"fcs",
        "mano_base_kwargs":{
          "ch_in":512, #c_dim,
          "ch_out":512, #h_dim,
          "ch_hiddens":[512],
          "activation":"relu",
          "dropout":0.0,
          "flatten":false
        },
        "st_head":"fcs",
        "obj_st_head":null
      },
      "loss":{
        #"loss_types":["mesh_predictor_s", "mesh_predictor_u", "flow_s", "flow_u"],
