{ 
  "inherit_from":"configs/miniInterhandv1/data_cfg.json",
  "metrics":{
    "names":["hand3d"],
    "ops":{
      #"mesh_predictor_s__xyz_mean3d":"min",
      #"mesh_predictor_u__xyz_mean3d":"min",
      #"flow_s__xyz_mean3d":"min",
      #"flow_u__xyz_mean3d":"min",
      "loss":"min"
