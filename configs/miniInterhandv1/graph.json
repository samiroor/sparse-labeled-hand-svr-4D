{
  "inherit_from":"configs/miniInterhandv1/data_cfg.json",
  "metrics":{
    "names":["hand3d"],
    "ops":{"xyz_mean3d":"min"}#{"loss": "min"}
  },
  "training":{
    "calc_mean_std":true
  },
  "model":{
    "name":"graph",
    "graph":{
      "c_dim":512,
      "h_dim":512,
      "scale_factor":0.0001,
      "trans_factor":100,
      "off_z":1.0,
      "return_tail_features":false,
      "return_encoder_tail_features":false,
      "return_encoder_features":false,
      "return_encoder_spatial_features":false,
      "adaptor_path":null,
      "ref_side":"right",
      "center_idx":0,
      "annot_metric":"m",
      "encoder":"resnet18",
      "encoder_kwargs":{
        "c_dim":512, #reduced feat out_dim
        "use_linear":true, #put an extra fc
        "return_spatial_features":false,
        "return_layer":"layer4"
      },
      "graph_base":"fcs",
      "graph_base_kwargs":{
        "ch_in":512, #c_dim,
        "ch_out":512, #h_dim,
        "ch_hiddens":[512],
        "activation":"relu",
        "dropout":0.0,
        "flatten":false
      },
      "ds_factors":[2,2,2,2],
      "graph_block_num":5,
      "st_head":"fcs",
      "obj_st_head":null,
      "mean_file":"?mininterhandv1_mean_meter.npy", 
      "std_file":"?mininterhandv1_std_meter.npy",
      "reference_mesh_file":"misc/graph/template_right_meter.obj",
      "downsample_file":"misc/graph/downsample_{}.pkl",
      "loss":{
        #"loss_types":["mesh_predictor_s", "mesh_predictor_tfeq_u"],
        #"mesh_predictor":{
          #"joints3d":[0.5,"l2"],
          #"verts3d":[0.5,"l2"]
        },
        #"mesh_predictor_tfeq":{
          #"joints3d":[0.5,"l2"],
          #"verts3d":[0.5,"l2"]
        }
      }
    }
  }
}
