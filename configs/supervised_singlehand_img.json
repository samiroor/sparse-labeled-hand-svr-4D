{
  "inherit_from":null,
  "seed":7777,
  "training":{
    "dataloader":{
      "batch_size":32,
      "workers": 8,
      "datasets":{
        #"dictionary config of dataloader {name}",
        "supervised_singlehand_img":{
          "name":"supervised_singlehand_img",
          "data":{
            "db_root": "misc/datapath/hand-pose",
            #"name":"mini_interhand_v1",
            #"annot_subset":"all",     #"all|human_annot|machine_annot", #INTERHAND
            "split":"train",          #"train|val|test", "split from which data should be read",
            #"use_mini_dataset": false,
            #"mini_dataset":{"test":["Capture0/ROM07_RT_Finger_Occlusions/cam400488/"]}, 
            #"if mini_dataset dict is empty & use_mini_dataset is True", 
            #"json file in './misc would be received",
            #"images_features":"image_features_{split}.pickle",
            #"images_features are saved extracted features from a pretrained net",
            #"ref_handside":"right",   #"left|interacting",
            "annot_metric": "m",
            "crop_bbox": false,
            "crop_factor": 1.2,
            "res_size": [256,256],
            "ref_bone": [8,9],
            "root_joint": 0,
            "labelset": [
              "image",
              "joints3d",
              "joints3d_rel",
              "mano_params",
              "verts3d"],
            #"label_set would be avaliable_annotation in loader",
            #"min_len_video":64,  #FILTER SHORT VIDEOS
            #"nseq frames in loader batch with desired spacing",
            "supervise_fraction": 1.0,
            "add_first_last_frame": true,
            #"supervised fraction could be used to turn off supervisory of some frames",
            "augmentation": {
              "do_scale": false, #"bool same as crop_bbox",
              "same_scale":false ,
              "scale_jitter": 0.0,
              "do_rot": true,
              "same_rot": true,
              "max_rot": 0.3925,
              "do_center": true,
              "same_center": true,
              "center_jitter": 0.1,
              "do_color": true,
              "same_color": false,
              "color": {
                "hue": 0.15,
                "saturation": 0.5,
                "contrast": 0.5,
                "brightness": 0.5,
                "blur_radius": 0.5
              }
            }
            # "same_{} means to have same augmentation in picked sequenced frames"
          }
        }
      }
    }
  },
  "evaluating":{
    "dataloader":{
      "batch_size":32,
      "workers": 8,
      "datasets":{
        #"dictionary config of dataloader {name}",
        "supervised_singlehand_img":{
          "name":"supervised_singlehand_img",
          "data":{
            "db_root": "misc/datapath/hand-pose",
            #"name":"mini_interhand_v1",
            #"annot_subset":"all",     #"all|human_annot|machine_annot", #INTERHAND
            "split":"val",          #"train|val|test", "split from which data should be read",
            #"use_mini_dataset": false,
            #"mini_dataset":{"test":["Capture0/ROM07_RT_Finger_Occlusions/cam400488/"]}, 
            #"if mini_dataset dict is empty & use_mini_dataset is True", 
            #"json file in './misc would be received",
            #"images_features":"image_features_{split}.pickle",
            #"images_features are saved extracted features from a pretrained net",
            #"ref_handside":"right",   #"left|interacting",
            "annot_metric": "m",
            "crop_bbox": false,
            "crop_factor": 1.2,
            "res_size": [256,256],
            "ref_bone": [8,9],
            "root_joint": 0,
            "labelset": [
              "image",
              "joints3d",
              "joints3d_rel",
              "mano_params",
              "verts3d"],
            #"label_set would be avaliable_annotation in loader",
            #"min_len_video":64,  #FILTER SHORT VIDEOS
            #"nseq frames in loader batch with desired spacing",
            "supervise_fraction": 1.0,
            "add_first_last_frame": true,
            #"supervised fraction could be used to turn off supervisory of some frames",
            "augmentation": {}
            # "same_{} means to have same augmentation in picked sequenced frames"
          }
        }
      }
    }
  },
  "metrics":{
    "names":["hand3d"],
    "ops":{}#{"loss": "min"}
  }
}
